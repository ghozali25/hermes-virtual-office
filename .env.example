# ==========================================
# 9Router Virtual Office — Configuration
# ==========================================
# Copy to .env and fill in.

# ---- 9Router AI Gateway ------------------------------------------------------
# 9Router is the core AI backend for the virtual office, replacing the local 
# Hermes agent stack. It acts as the gateway for chat, meetings, and agent tasks.
AI_BASE_URL=https://9router.hiddenlab.me/v1
AI_API_KEY=sk-e65b3e30630e47d0-cxcd2b-173194e1
AI_MODEL=Free-Tier

# Meeting shape and resilience
MAX_MEETING_TURNS=10
DEFAULT_MEETING_ROUNDS=2
# Upstream gateways intermittently answer 503; turns are retried.
MEETING_TURN_TIMEOUT_MS=120000
MEETING_TURN_RETRIES=3
MEETING_TURN_BACKOFF_MS=4000

# ---- Storage -----------------------------------------------------------------
# SQLite DB path and meeting transcripts.
DATA_DIR=./data

# ---- Frontend ----------------------------------------------------------------
# How often the board re-polls the API, in ms (default 4000).
# NEXT_PUBLIC_POLL_MS=4000

# ---- Development only --------------------------------------------------------
# Exposes window.__office for end-to-end probes. Off unless set to 1.
# NEXT_PUBLIC_E2E_HOOK=1

# ---- Chat -------------------------------------------------------------------
# How long one chat turn may take. An agent may run tools before answering.
# CHAT_TIMEOUT_MS=180000

